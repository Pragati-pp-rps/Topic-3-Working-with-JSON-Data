        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "02124977-e754-4d69-b1ca-93db7b4ca619",
      "name": "HTTP Request - Send JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        704,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => { const response = item.json; const sent = response.data || response.json || {}; const checks = { customer_name: sent.customer_name === \"Priya Sharma\", city: sent.city === \"Pune\", first_item: sent.first_item === \"Laptop\", second_item_quantity: Number(sent.second_item_quantity) === 2, total_amount: Number(sent.total_amount) === 46000 }; return { json: { validation_status: Object.values(checks).every(Boolean) ? \"PASSED\" : \"FAILED\", checks, sent_payload: sent, message: \"Nested JSON extraction, Set node mapping and HTTP response checked\" } }; });"
      },
