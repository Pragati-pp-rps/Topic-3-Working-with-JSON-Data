    {
      "parameters": {
        "jsCode": "const payload = { customer: { id: \"CUST-101\", name: \"Priya Sharma\", email: \"priya@example.com\", address: { city: \"Pune\", state: \"Maharashtra\", country: \"India\" } }, order: { id: \"ORD-1001\", status: \"confirmed\", items: [{ sku: \"LAP-01\", name: \"Laptop\", quantity: 1, price: 45000 }, { sku: \"MOU-02\", name: \"Mouse\", quantity: 2, price: 500 }], payment: { method: \"UPI\", paid: true } } }; return [{ json: payload }];"
      },
      "id": "9d94dba4-7b63-45fd-8824-3f7d0831d383",
      "name": "Create Nested JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "customer_name",
              "value": "={{ $json.customer.name }}",
              "type": "string"
            },
            {
              "id": "b",
              "name": "customer_email",
              "value": "={{ $json.customer.email }}",
              "type": "string"
            },
            {
              "id": "c",
              "name": "city",
              "value": "={{ $json.customer.address.city }}",
              "type": "string"
            },
            {
              "id": "d",
              "name": "order_id",
              "value": "={{ $json.order.id }}",
              "type": "string"
            },
            {
              "id": "e",
              "name": "first_item",
              "value": "={{ $json.order.items[0].name }}",
              "type": "string"
            },
            {
              "id": "f",
              "name": "second_item_quantity",
              "value": "={{ $json.order.items[1].quantity }}",
              "type": "number"
            },
            {
              "id": "g",
              "name": "total_amount",
              "value": "={{ $json.order.items.reduce((sum, item) => sum + item.quantity * item.price, 0) }}",
              "type": "number"
            },
            {
              "id": "h",
              "name": "payment_method",
              "value": "={{ $json.order.payment.method }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c94150ff-cb66-4ac6-b8b3-8550169c4072",
      "name": "Edit Fields - Extract and Transform",
      "type": "n8n-nodes-base.set",
